# Raftaar (رفتار) — Environment Variables

# Application
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
API_PREFIX=/api/v1
CORS_ORIGIN=*

# Secrets & Security
JWT_ACCESS_SECRET=raftaar_jwt_access_super_secret_key_pk_2026
JWT_REFRESH_SECRET=raftaar_jwt_refresh_super_secret_key_pk_2026
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
COOKIE_SECRET=raftaar_cookie_signature_secret_92

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://raftaar_admin:raftaar_secret_pw@localhost:5432/raftaar_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=raftaar_admin
DB_PASSWORD=raftaar_secret_pw
DB_NAME=raftaar_db

# Redis & Queues
REDIS_URL=redis://localhost:6379

# Adapters & Providers
# Twilio SMS Provider
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+12015550123
TWILIO_MESSAGING_SERVICE_SID=

# Payments
# Options: mock | payfast | stripe
PAYMENT_PROVIDER=mock
PAYFAST_MERCHANT_ID=
PAYFAST_SECURED_KEY=
STRIPE_SECRET_KEY=

# Maps
# Options: mock | osm | google | mapbox
MAPS_PROVIDER=mock
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# Notifications
# Options: mock | resend | fcm
NOTIFICATION_PROVIDER=mock
RESEND_API_KEY=
FCM_SERVER_KEY=

# Anthropic Claude Integration
ANTHROPIC_API_KEY=sk-ant-api03-your_claude_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

